# Copy to .env and fill in. Never commit .env.
# See PRD.md section 13 for every variable and its meaning.

# Perflo agent key (perflo_live_... or perflo_test_...). Required unless FIXTURE_MODE=true.
PERFLO_AGENT_KEY=
PERFLO_BASE_URL=https://pay-per-use-api.perflo.ai

# LLM. Default provider is Cloudflare Workers AI through its OpenAI-compatible endpoint (ADR-0006).
# LLM_API_KEY is a Cloudflare API token with the "Workers AI: Read" permission on the account.
LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
LLM_MODEL=@cf/zai-org/glm-5.3
# Optional tool-loop override. Unset uses LLM_MODEL. gpt-oss-120b fails the second tool turn on Workers AI.
# LLM_LOOP_MODEL=@cf/zai-org/glm-5.3
LLM_API_KEY=
# Other providers: LLM_PROVIDER=openai (api.openai.com) or openai-compatible with LLM_BASE_URL set.
LLM_BASE_URL=

# Optional. When unset, basic and standard use 90000 ms and deep uses 120000 ms.
# RESEARCH_DEADLINE_MS=90000
TOOL_CONCURRENCY=4
VENDOR_TIMEOUT_MS=15000
DATABASE_PATH=./data/research.db

# true = serve recorded vendor responses from test/fixtures, spend nothing
FIXTURE_MODE=false

PORT=3000
LOG_LEVEL=info
